<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <CheckBox
        android:id="@+id/remoteEnabledCheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:clickable="false"
        android:focusable="false"
        android:text="@string/server_enabled" />

    <LinearLayout
        android:id="@+id/remoteSettingsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/server_base_url_hint"
            app:boxBackgroundColor="@android:color/white"
            app:boxStrokeColor="@color/calllog_border">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/baseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/server_access_token_hint"
            app:boxBackgroundColor="@android:color/white"
            app:boxStrokeColor="@color/calllog_border">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/accessTokenInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:inputType="textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testServerConnectionButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/test_server_connection" />

        <TextView
            android:id="@+id/serverConnectionTestStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_settings_info"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp"
            android:textColor="@color/calllog_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pendingTopicNotesStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_settings_info"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp"
            android:textColor="@color/calllog_text"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryPendingTopicNotesButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/server_retry_pending_notes"
            app:strokeColor="@color/calllog_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggleAdvancedServerSettingsButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/server_advanced_settings_show" />

        <LinearLayout
            android:id="@+id/advancedServerSettingsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_lookup_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/lookupPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_form_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/formPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_history_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/historyPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_history_lookup_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/historyLookupPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_sync_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/syncPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_sync_edit_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/syncEditPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_company_phase_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/companyPhasePathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_company_destinations_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/companyDestinationsPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_contacts_shared_lookup_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/contactsSharedLookupPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_profile_crm_contacts_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profileCrmContactsPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_company_users_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/companyUsersPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_auth_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/authPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_invitations_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/invitationsPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_billing_path_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/billingPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_backup_code_hint"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="@color/calllog_border">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/serverBackupCodeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="number"
                    android:maxLength="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/server_backup_code_description"
                android:textColor="@color/calllog_muted_text"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveServerSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/save_server_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restoreServerSettingsButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/restore_server_settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
