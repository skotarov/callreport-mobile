<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/calllog_surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/calllog_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/settings_profile_companies_section"
                    android:src="@drawable/ic_settings_registration" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_profile_companies_section"
                    android:textColor="@color/calllog_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_profile_companies_description"
                android:textColor="@color/calllog_muted_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/registrationCurrentProfileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@color/calllog_debug_surface"
                android:padding="14dp"
                android:textColor="@color/calllog_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registrationEditProfileButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:text="@string/settings_registration_edit_profile"
                android:visibility="gone"
                app:icon="@drawable/ic_settings_registration"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/calllog_text"
                app:strokeColor="@color/calllog_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registrationLogoutButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:text="@string/settings_registration_logout"
                android:visibility="gone"
                app:icon="@drawable/ic_settings_application"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/calllog_text"
                app:strokeColor="@color/calllog_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registrationCompanyAccountButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:minHeight="50dp"
                android:text="@string/settings_registration_profile_license"
                app:icon="@drawable/ic_settings_application"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/calllog_text"
                app:strokeColor="@color/calllog_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registrationJoinCompanyButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:minHeight="50dp"
                android:text="@string/settings_registration_join"
                app:icon="@drawable/ic_settings_rm_contacts"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/calllog_text"
                app:strokeColor="@color/calllog_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registrationServerAddressButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:text="@string/settings_registration_server_address"
                android:textColor="@color/calllog_text"
                app:backgroundTint="@color/calllog_debug_surface"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_cloud_sync"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/calllog_text"
                app:strokeColor="@color/calllog_accent"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/registrationConnectedCompaniesCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/calllog_surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/calllog_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/settings_registration_companies_section"
                    android:src="@drawable/ic_settings_server" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_registration_companies_section"
                    android:textColor="@color/calllog_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_registration_companies_description"
                android:textColor="@color/calllog_muted_text"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/registrationCompaniesProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/registrationCompaniesStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_registration_companies_loading"
                android:textColor="@color/calllog_muted_text"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/registrationCompaniesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registrationRefreshCompaniesButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:minHeight="46dp"
                android:text="@string/settings_registration_refresh_companies"
                app:icon="@drawable/ic_settings_server"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/calllog_text"
                app:strokeColor="@color/calllog_border"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
